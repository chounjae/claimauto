{
  "permissions": {
    "allow": [
      "Bash(npm run build*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npm run*)",
      "Bash(next build*)",
      "Bash(next dev*)",
      "Bash(npx prisma*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push origin feature*)",
      "Bash(git push origin develop*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(gh issue create*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(ls*)",
      "Bash(find .claude*)",
      
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git push origin main*)",
      "Bash(*--no-verify*)",
      "Bash(DROP TABLE*)",
      "Bash(DELETE FROM * WHERE 1*)",
      "Bash(kubectl delete*)",
      "Bash(chmod 777*)",
      "Bash(*prisma migrate reset*)",
      "Bash(*prisma db push --force*)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(* > /dev/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-guard.sh"
          }
        ],
        "description": "위험 명령 사전 차단"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-compile.sh",
            "timeout": 60
          }
        ],
        "description": "파일 수정 후 TypeScript 컴파일 자동 확인"
      }
    ]
  }
}
